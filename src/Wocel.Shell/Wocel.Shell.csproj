<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cho dự án kiểm thử gọi được các hàm internal đã tách riêng để test -->
    <InternalsVisibleTo Include="Wocel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wocel.Core\Wocel.Core.csproj" />
    <ProjectReference Include="..\Wocel.Word\Wocel.Word.csproj" />
    <ProjectReference Include="..\Wocel.Excel\Wocel.Excel.csproj" />
    <!-- Wocel Capture chạy trong cùng exe: Program.Main rẽ nhánh theo tham số capture/background -->
    <ProjectReference Include="..\Wocel.Capture.Desktop\Wocel.Capture.Desktop.csproj" />
  </ItemGroup>

  <!-- Bản phát hành chỉ gồm một tệp exe: bỏ symbol native (SkiaSharp/HarfBuzz) và runtimeconfig
       của Wocel.Capture.Desktop, vốn được chép theo vì project đó cũng là WinExe. -->
  <Target Name="TrimNonRuntimePublishFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' or '%(Filename)%(Extension)' == 'Wocel.Capture.Desktop.runtimeconfig.json'" />
    </ItemGroup>
  </Target>
</Project>
