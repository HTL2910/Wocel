<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Wocel.Capture.Desktop.ViewModels"
        x:Class="Wocel.Capture.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Wocel Capture"
        Icon="avares://Wocel.Capture.Desktop/Assets/app-icon.png"
        Width="620" Height="620"
        MinWidth="520" MinHeight="480"
        Background="{DynamicResource AppBackgroundBrush}">

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Topbar: Sleek Header with Cloud Settings and Capture Button -->
    <Border Grid.Row="0" Classes="topbar">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <StackPanel Spacing="3" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Fill="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Wocel Capture" Classes="title" VerticalAlignment="Center" />
            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
            </Border>
          </StackPanel>
          <TextBlock Text="Chụp ảnh màn hình &amp; Chú thích tức thì" Classes="subtitle" />
        </StackPanel>
        
        <!-- Button Cài đặt Cloud trên Topbar -->
        <Button Grid.Column="1"
                Command="{Binding ShowSettingsCommand}"
                AutomationProperties.Name="Sign in with Google"
                Classes="secondary"
                ToolTip.Tip="Cài đặt kết nối ImageKit Cloud"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Path Data="M19.35,10.04 C18.67,6.59 15.64,4 12,4 C9.11,4 6.6,5.64 5.35,8.04 C2.34,8.36 0,10.91 0,14 C0,17.31 2.69,20 6,20 H19 C21.76,20 24,17.76 24,15 C24,12.36 21.95,10.22 19.35,10.04 Z"
                  Fill="{DynamicResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="Cloud (ImageKit)" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        
        <!-- Button Chụp ảnh -->
        <Button Grid.Column="2"
                Command="{Binding CaptureCommand}"
                AutomationProperties.Name="Capture screen"
                Classes="primary"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Path Data="M9,2 L7.17,4 H4 C2.9,4 2,4.9 2,6 V18 C2,19.1 2.9,20 4,20 H20 C21.1,20 22,19.1 22,18 V6 C22,4.9 21.1,4 20,4 H16.83 L15,2 H9 Z M12,17 C9.24,17 7,14.76 7,12 C7,9.24 9.24,7 12,7 C14.76,7 17,9.24 17,12 C17,14.76 14.76,17 12,17 Z"
                  Fill="{DynamicResource PrimaryForegroundBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Text="Chụp màn hình" FontWeight="Bold" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Main Content: Direct Clean Settings & Storage Hub (No Duplicate Hero Cards) -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="20,14">
      <StackPanel Spacing="16" MaxWidth="580" HorizontalAlignment="Center">
        
        <!-- 1. Local Storage Card -->
        <Border Background="#0C1527" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="📁" FontSize="14" VerticalAlignment="Center" />
              <TextBlock Text="Thư mục lưu ảnh trên máy (Local)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" />
            </StackPanel>
            
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
              <TextBox x:Name="LocalSaveDirectoryBox" PlaceholderText="Mặc định: ~/Pictures/WocelCaptures"
                       Background="#0B1220" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="6" FontSize="13" />
              <Button Grid.Column="1" Click="BrowseLocalFolderClick" Classes="secondary" Content="Duyệt..." MinHeight="32" Padding="12,4" />
              <Button Grid.Column="2" Click="OpenLocalFolderClick" Classes="secondary" Content="Mở thư mục ↗" MinHeight="32" Padding="12,4" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- 2. ImageKit Cloud Settings Card -->
        <Border Background="#0C1527" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="18">
          <StackPanel Spacing="14">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="☁️" FontSize="14" VerticalAlignment="Center" />
                <TextBlock Text="Cấu hình Lưu trữ Cloud (ImageKit.io)" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="Lưu ảnh an toàn, tải lên siêu tốc và tự động tạo link chia sẻ trực tiếp." Classes="muted" FontSize="11" />
            </StackPanel>

            <!-- Guide Box -->
            <Border Background="#0C1B2E" CornerRadius="8" BorderBrush="#0369A1" BorderThickness="1" Padding="12">
              <StackPanel Spacing="6">
                <TextBlock Text="💡 Lấy API Key miễn phí (20 GB vĩnh viễn):" FontWeight="SemiBold" FontSize="12" Foreground="#38BDF8" />
                <Button Click="OpenImageKitApiKeysPage" Classes="secondary" HorizontalAlignment="Left" Padding="10,4" MinHeight="26">
                  <TextBlock Text="🔗 Mở trang lấy API Key (ImageKit.io) ↗" FontWeight="SemiBold" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" />
                </Button>
                <TextBlock Text="Copy URL-endpoint và Private API Key rồi dán vào 2 ô bên dưới." FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" />
              </StackPanel>
            </Border>

            <!-- Inputs -->
            <StackPanel Spacing="10">
              <StackPanel Spacing="4">
                <TextBlock Text="URL-endpoint:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ForegroundBrush}" />
                <TextBox x:Name="ImageKitUrlEndpointBox" PlaceholderText="vd: https://ik.imagekit.io/wocel_team"
                         Background="#0B1220" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="6" FontSize="13" />
              </StackPanel>

              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Private API Key:" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ForegroundBrush}" />
                  <Button Grid.Column="1" Click="ToggleApiKeyVisibilityClick" Classes="tool" Content="👁 Hiện/Ẩn" FontSize="11" Padding="6,2" MinHeight="22" />
                </Grid>
                <TextBox x:Name="ImageKitPrivateKeyBox" PlaceholderText="vd: private_xxxxxxxxxxxxxxxxxxxxxxxx"
                         PasswordChar="•" Background="#0B1220" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="6" FontSize="13" />
              </StackPanel>

              <StackPanel Spacing="4">
                <TextBlock Text="Thư mục lưu trữ (Folder trên ImageKit):" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource ForegroundBrush}" />
                <TextBox x:Name="ImageKitFolderBox" Text="/wocel-captures"
                         Background="#0B1220" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="6" FontSize="13" />
              </StackPanel>

              <CheckBox x:Name="ImageKitAutoUploadCheck" Content="Tự động tải lên ImageKit sau khi chụp ảnh và sao chép link"
                        Foreground="{DynamicResource ForegroundBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Status Notification -->
            <TextBlock x:Name="ImageKitStatusLabel" Text="" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap" />

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Click="TestImageKitConnectionClick" Classes="secondary" Content="Kiểm tra kết nối" MinHeight="34" Padding="14,6" />
              <Button Click="SaveImageKitSettingsClick" Classes="primary" Content="Lưu cấu hình" MinHeight="34" Padding="18,6" />
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Status Bar -->
    <Border Grid.Row="2" Classes="statusbar">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}" AutomationProperties.Name="Application status" />
      </Grid>
    </Border>
  </Grid>
</Window>