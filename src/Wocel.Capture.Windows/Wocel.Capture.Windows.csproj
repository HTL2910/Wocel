<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Wocel.Capture.Windows</RootNamespace>
    <AssemblyName>Wocel Capture</AssemblyName>
    <Product>Wocel Capture</Product>
    <Description>Chụp, chú thích và chia sẻ ảnh màn hình qua Google Drive.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF requires manifest DPI declarations; WinForms is referenced only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Wocel.Capture.Core/Wocel.Capture.Core.csproj" />
  </ItemGroup>
</Project>
