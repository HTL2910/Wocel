<Application x:Class="Wocel.Capture.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0D9488" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0F766E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F0FDFA" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#134E4A" />
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#526F6C" />
    <SolidColorBrush x:Key="BorderBrush" Color="#99F6E4" />
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
      <Setter Property="Foreground" Value="{StaticResource ForegroundBrush}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Margin" Value="4" />
      <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
    </Style>
  </Application.Resources>
</Application>
