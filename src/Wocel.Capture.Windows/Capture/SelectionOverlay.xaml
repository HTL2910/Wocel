<Window x:Class="Wocel.Capture.Windows.Capture.SelectionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Cursor="Cross" Focusable="True" KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">
  <Grid ClipToBounds="True">
    <Image x:Name="FrozenImage" Stretch="Fill" />
    <Rectangle Fill="#99000000" />
    <Canvas x:Name="OverlayCanvas">
      <Rectangle x:Name="SelectionBox" Visibility="Collapsed" Stroke="#FFFFFF" StrokeThickness="2" Fill="#12FFFFFF" />
      <Border x:Name="SizeBadge" Visibility="Collapsed" Background="#E6111827" CornerRadius="4" Padding="7,3">
        <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
      </Border>
    </Canvas>
    <Border VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20" Background="#DD111827" CornerRadius="6" Padding="12,7">
      <TextBlock Foreground="White" Text="Kéo để chọn vùng • Enter xác nhận • Esc hủy" />
    </Border>
  </Grid>
</Window>
