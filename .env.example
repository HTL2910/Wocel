# ===================================================
# WOCEL APPLICATION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your actual credentials.
# ===================================================

# --- SUPABASE CONFIGURATION ---
# Your Supabase Project URL (e.g., https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anon Key (Safe for client apps with RLS enabled)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Supabase Storage Bucket for Documents and Backups
SUPABASE_STORAGE_BUCKET=wocel-documents

# --- CLOUDINARY MEDIA CONFIGURATION ---
# Your Cloudinary Cloud Name
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Your Cloudinary API Key
CLOUDINARY_API_KEY=your_cloudinary_api_key

# Your Cloudinary API Secret (Keep secret! Recommended to use unsigned presets for client desktop)
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Cloudinary Upload Preset Name for direct client uploads
CLOUDINARY_UPLOAD_PRESET=wocel_assets_preset

# --- APPLICATION SETTINGS ---
# Environment: Development | Staging | Production
WOCEL_ENV=Development
WOCEL_ENABLE_CLOUD_SYNC=true
WOCEL_AUTO_SAVE_INTERVAL_SECONDS=60

# --- ACTIVITY LOG (nhật ký thao tác, phục vụ truy vết lỗi) ---
# Bật/tắt việc đẩy nhật ký lên Supabase. Nhật ký cục bộ luôn được ghi.
WOCEL_ENABLE_ACTIVITY_LOG=true

# Tên bảng chứa nhật ký (tạo bằng docs/supabase-activity-log.sql)
WOCEL_LOG_TABLE=wocel_activity_logs

# Bao nhiêu giây đẩy nhật ký lên server một lần
WOCEL_LOG_FLUSH_SECONDS=20
